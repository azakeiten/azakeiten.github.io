rules_version = '2';

// ================================================================
//  AZAKEI 文化祭投票・クイズランキング・部員の投稿 — Firestore セキュリティルール
//  Firebase コンソール →「Firestore Database」→「ルール」に貼り付けて「公開」。
//
//  データの形:
//    polls/{pollId}              … 集計（same: 3, econ: 5, ...）誰でも読める
//    polls/{pollId}/votes/{uid}  … 1人1件の投票記録（本人だけ読める）
//
//  守っていること:
//    ・1つの匿名アカウントにつき1票だけ（投票記録が既にあれば集計を増やせない）
//    ・集計は「投票記録の作成と同時に、選んだ項目を +1」する時しか変えられない
//    ・投票の書き換え・削除はできない
//  ※ 選択肢を変えたら、下の options() も content.js と同じに直すこと。
// ================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function options() {
      return ['same', 'econ', 'fun', 'insta', 'food', 'life', 'society'];
    }
    function pollPath(pollId) {
      return /databases/$(database)/documents/polls/$(pollId);
    }
    function votePath(pollId) {
      return /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
    }
    function signedIn() {
      return request.auth != null;
    }

    match /polls/{pollId} {
      allow read: if pollId.matches('festival-[0-9]{4}');

      // 最初の1回だけ：全項目 0 の状態で作成できる
      allow create: if signedIn()
        && pollId.matches('festival-[0-9]{4}')
        && request.resource.data.keys().hasOnly(options())
        && request.resource.data.keys().hasAll(options())
        && request.resource.data.same == 0
        && request.resource.data.econ == 0
        && request.resource.data.fun == 0
        && request.resource.data.insta == 0
        && request.resource.data.food == 0
        && request.resource.data.life == 0
        && request.resource.data.society == 0;

      // 投票：自分の投票記録を同時に作るときだけ、選んだ項目を +1
      allow update: if signedIn()
        && !exists(votePath(pollId))
        && existsAfter(votePath(pollId))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([getAfter(votePath(pollId)).data.choice])
        && request.resource.data[getAfter(votePath(pollId)).data.choice]
             == resource.data[getAfter(votePath(pollId)).data.choice] + 1;

      allow delete: if false;

      match /votes/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list: if false;

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['choice', 'at'])
          && request.resource.data.choice in options()
          && request.resource.data.at == request.time
          && getAfter(pollPath(pollId)).data[request.resource.data.choice]
               == get(pollPath(pollId)).data[request.resource.data.choice] + 1;

        allow update, delete: if false;
      }
    }

    // ================================================================
    //  億万長者クイズのランキング
    //    quizRanking/{uid} … { name: 1〜12 文字, score: 1〜38880 の整数, at: 登録時刻 }
    //    ・誰でも読める（ランキング表示のため）
    //    ・自分の 1 件だけ作れる。上書きは「前より高い点」のときだけ
    //    ・削除はできない（不適切な名前は、Firebase コンソールから部員が消す）
    // ================================================================
    function validRankEntry() {
      return request.resource.data.keys().hasOnly(['name', 'score', 'at'])
        && request.resource.data.keys().hasAll(['name', 'score', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 38880
        && request.resource.data.at == request.time;
    }

    match /quizRanking/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid && validRankEntry();
      allow update: if signedIn() && request.auth.uid == uid && validRankEntry()
        && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    // ================================================================
    //  部員用 更新ページ（admin.html）の投稿
    //    posts/{id} … { kind: diary|event, title, body, date, end, place, tag, link, author, updatedAt }
    //    ・誰でも読める（サイトに表示するため）
    //    ・書く・直す・消すのは、下の一覧にある Google アカウントだけ
    //    ・部員を増やすときは、ここと admin.js の EDITORS の両方にメールアドレスを足す
    // ================================================================
    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['azakeiten@gmail.com'];
    }
    function validPost() {
      let d = request.resource.data;
      return d.keys().hasOnly(['kind', 'title', 'body', 'date', 'end', 'place', 'tag', 'link', 'author', 'updatedAt'])
        && d.kind in ['diary', 'event']
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 40
        && d.body is string && d.body.size() <= 300
        && d.date is string && (d.date == '' || d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && d.end is string && (d.end == '' || d.end.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && d.place is string && d.place.size() <= 40
        && d.tag is string && d.tag.size() <= 12
        && d.link is string && d.link.size() <= 200
        && d.author == request.auth.token.email
        && d.updatedAt == request.time;
    }

    match /posts/{id} {
      allow read: if true;
      allow create, update: if isEditor() && validPost();
      allow delete: if isEditor();
    }
  }
}
